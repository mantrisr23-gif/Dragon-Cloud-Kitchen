generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(cuid())
  title       String   
  desc        String   
  price       Float    
  category    String   
  featured    Boolean  @default(false)
  image       String   
  isAvailable Boolean  @default(true)      
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}